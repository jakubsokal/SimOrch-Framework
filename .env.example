# Example environment variables for LLM providers and API keys.
# Copy this file to `.env` and replace `xxxx` with real keys.

# OpenAI API key: used to access OpenAI models (e.g., GPT).
# Set this to your OpenAI API key (prefixed with 'sk-' where applicable).
OPENAI_API_KEY=xxxx

# Gemini API key: used for Gemini / Google Cloud services.
# Provide the API key for Google Cloud services or GenAI usage.
GEMINI_API_KEY=xxxx

# Anthropic API key: used to access Anthropic Claude models.
# Set this to your Anthropic API key if you use Anthropic providers.
ANTHROPIC_API_KEY=xxxx

# GROQ API key: used for GROQ LLM provider integrations.
# Provide your GROQ API key if using the Groq LLM service.
GROQ_API_KEY=xxxx
